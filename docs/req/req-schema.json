{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CS5351 Requirements Registry Schema",
  "type": "object",
  "required": ["project", "version", "last_updated", "requirements"],
  "properties": {
    "project": { "type": "string" },
    "version": { "type": "string" },
    "last_updated": { "type": "string", "format": "date" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "statement",
          "fit_criterion",
          "priority",
          "tradeoff",
          "enforcing_component",
          "verification_method",
          "owner"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(FR|NFR|INV)-[A-Z0-9]+-[0-9]{3}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "functional",
              "invariant",
              "quality",
              "performance",
              "cost",
              "governance",
              "security"
            ]
          },
          "statement": { "type": "string" },
          "fit_criterion": { "type": "string" },
          "priority": {
            "type": "string",
            "enum": ["Must", "Should", "Could", "Wont"]
          },
          "tradeoff": { "type": "string" },
          "enforcing_component": { "type": "string" },
          "verification_method": { "type": "string" },
          "owner": { "type": "string" },
          "source": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
