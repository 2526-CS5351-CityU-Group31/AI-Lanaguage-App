{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Use Log Schema",
  "type": "object",
  "required": ["sessions"],
  "properties": {
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "session_id",
          "date",
          "member",
          "branch",
          "agent",
          "purpose",
          "files_touched",
          "human_interventions"
        ],
        "properties": {
          "session_id": { "type": "string", "pattern": "^SES-[0-9]{3,}$" },
          "date": { "type": "string", "format": "date" },
          "member": { "type": "string" },
          "branch": { "type": "string" },
          "agent": { "type": "string" },
          "purpose": { "type": "string", "minLength": 10 },
          "files_touched": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "human_interventions": {
            "type": "string",
            "description": "Summary of what the human approved, rejected, or redirected."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
